{
  "expo": {
    "name": "Resolve",
    "slug": "resolve",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFD900",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Resolve usa suas fotos para você mostrar o problema ao profissional e escolher sua foto de perfil.",
          "cameraPermission": "O Resolve usa a câmera para você fotografar o problema e enviar ao profissional."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Resolve usa sua localização para marcar de onde você atende (profissionais) e mostrar quem atende perto de você."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FFD900",
          "defaultChannel": "mensagens"
        }
      ]
    ],
    "scheme": "resolve",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "957feeac-d508-4ea7-ac87-740dfb72a261"
      }
    },
    "owner": "nathanssna"
  }
}
